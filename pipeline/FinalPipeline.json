							"type": "Query",
							"text": "if OBJECT_ID('[dbo].[1_ test]') is not null drop procedure [dbo].[1_ test]\nif OBJECT_ID('[dbo].[2_insert]') is not null drop procedure [dbo].[2_insert]"
