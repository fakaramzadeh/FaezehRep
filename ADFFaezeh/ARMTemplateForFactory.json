		{
			"name": "[concat(parameters('factoryName'), '/DF_BlobDraft2AzureSql')]",
			"type": "Microsoft.DataFactory/factories/dataflows",
			"apiVersion": "2018-06-01",
			"properties": {
				"type": "MappingDataFlow",
				"typeProperties": {
					"sources": [
						{
							"dataset": {
								"referenceName": "DS_BLOBSheet_Draft",
								"type": "DatasetReference"
							},
							"name": "BlobDraft"
						}
					],
					"sinks": [
						{
							"dataset": {
								"referenceName": "DS_Azure_tblDraft",
								"type": "DatasetReference"
							},
							"name": "azureSqltblDraft"
						}
					],
					"transformations": [
						{
							"name": "select1"
						},
						{
							"name": "filter1"
						}
					],
					"scriptLines": [
						"source(output(",
						"          Id as string,",
						"          TrDate as string,",
						"          Title as string,",
						"          Deb as string,",
						"          Cred as string,",
						"          Balance as string,",
						"          Acc as string,",
						"          TrDesc as string,",
						"          Who as string,",
						"          YearDesc as string,",
						"          SubCat as string,",
						"          Brand as string,",
						"          Insert as string",
						"     ),",
						"     allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     ignoreNoFilesFound: false) ~> BlobDraft",
						"BlobDraft select(mapColumn(",
						"          TrDate,",
						"          Title,",
						"          Deb,",
						"          Cred,",
						"          Balance,",
						"          Acc",
						"     ),",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true) ~> select1",
						"select1 filter(!isNull(TrDate) || TrDate!='') ~> filter1",
						"filter1 sink(allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     deletable:false,",
						"     insertable:true,",
						"     updateable:false,",
						"     upsertable:false,",
						"     recreate:true,",
						"     format: 'table',",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true,",
						"     errorHandlingOption: 'stopOnFirstError') ~> azureSqltblDraft"
					]
				}
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/datasets/DS_BLOBSheet_Draft')]",
				"[concat(variables('factoryId'), '/datasets/DS_Azure_tblDraft')]"
			]
		}
