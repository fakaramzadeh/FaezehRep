{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "ADFFaezeh"
		},
		"LS_Azure Sql_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'LS_Azure Sql'"
		},
		"LS_Blob_connectionString": {
			"type": "secureString",
			"metadata": "Secure string for 'connectionString' of 'LS_Blob'"
		},
		"LS_OnpermiseSql_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'LS_OnpermiseSql'"
		},
		"LS_Azure Sql_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "testserverfara.database.windows.net"
		},
		"LS_Azure Sql_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "Accounting"
		},
		"LS_Azure Sql_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "saadmin"
		},
		"LS_GoogleSheet_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://docs.google.com"
		},
		"LS_OnpermiseSql_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "Localhost"
		},
		"LS_OnpermiseSql_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "Accounting"
		},
		"LS_OnpermiseSql_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "sa"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "ADFFaezeh_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"LS_Azure Sql_password": {
						"value": "[parameters('LS_Azure Sql_password')]"
					},
					"LS_Blob_connectionString": {
						"value": "[parameters('LS_Blob_connectionString')]"
					},
					"LS_OnpermiseSql_password": {
						"value": "[parameters('LS_OnpermiseSql_password')]"
					},
					"LS_Azure Sql_properties_typeProperties_server": {
						"value": "[parameters('LS_Azure Sql_properties_typeProperties_server')]"
					},
					"LS_Azure Sql_properties_typeProperties_database": {
						"value": "[parameters('LS_Azure Sql_properties_typeProperties_database')]"
					},
					"LS_Azure Sql_properties_typeProperties_userName": {
						"value": "[parameters('LS_Azure Sql_properties_typeProperties_userName')]"
					},
					"LS_GoogleSheet_properties_typeProperties_url": {
						"value": "[parameters('LS_GoogleSheet_properties_typeProperties_url')]"
					},
					"LS_OnpermiseSql_properties_typeProperties_server": {
						"value": "[parameters('LS_OnpermiseSql_properties_typeProperties_server')]"
					},
					"LS_OnpermiseSql_properties_typeProperties_database": {
						"value": "[parameters('LS_OnpermiseSql_properties_typeProperties_database')]"
					},
					"LS_OnpermiseSql_properties_typeProperties_userName": {
						"value": "[parameters('LS_OnpermiseSql_properties_typeProperties_userName')]"
					}
				}
			},
			"dependsOn": []
		}
	]
}